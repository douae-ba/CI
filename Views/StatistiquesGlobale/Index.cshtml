@{
    ViewData["Title"] = "Statistiques Globale";
    ViewData["ActivePage"] = "stats-globale";
    Layout = "_AppLayout";
}@Html.AntiForgeryToken()

<div class="page-header">
    <div>
        <h1>Statistiques Globale</h1>
        <p class="breadcrumb">Orhan Automotive — Global CI Initiatives List 2026</p>
    </div>
    <span class="badge-count" id="entryCount">0 entrées</span>
</div>

<div class="page-body">
    <div class="export-intro">
        <h2 class="section-title">Statistiques Globale</h2>
        <p class="section-subtitle">Vue globale des typologies — Kaizen, A3, VAVE</p>
    </div>

    <div class="filters-bar">
        <select class="select-input" id="filterTypeGlobal"></select>
        <select class="select-input" id="filterDelay"></select>
        <select class="select-input" id="filterCompletion"></select>
        <select class="select-input" id="filterPdca"></select>
        <select class="select-input" id="filterMoisGlobal"></select>
        <select class="select-input" id="filterAnneeGlobal"></select>
        <button class="btn btn-secondary btn-push-right" id="openHeadcountBtn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Effectif par Département
        </button>
    </div>

    <div class="kpi-grid kpi-grid-3">
        <div class="kpi-card">
            <div class="kpi-icon purple kpi-icon-label">KAIZEN</div>
            <p class="kpi-label">Nombre de Kaizen</p>
            <p class="kpi-value" id="kpiKaizenCount">0</p>
            <p class="kpi-sub" id="kpiKaizenPct">0% du total</p>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon blue kpi-icon-label">A3</div>
            <p class="kpi-label">Nombre A3</p>
            <p class="kpi-value" id="kpiA3Count">0</p>
            <p class="kpi-sub" id="kpiA3Pct">0% du total</p>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon red kpi-icon-label">VAVE</div>
            <p class="kpi-label">Nombre VAVE</p>
            <p class="kpi-value" id="kpiVaveCount">0</p>
            <p class="kpi-sub" id="kpiVavePct">0% du total</p>
        </div>
    </div>

    <div class="chart-card chart-card-wide">
        <h3>Tableau Kaizen &amp; A3/VAVE par Département</h3>
        <div class="table-scroll">
            <table class="objectives-table compact-table" id="kaizenSuggTable">
    <thead id="kaizenSuggThead"></thead>
    <tbody id="kaizenSuggTbody"></tbody>
</table>
        </div>
    </div>

    <div class="chart-grid-2">
        <div class="chart-card">
            <div class="objectives-header">
                <h3 id="scopeChartTitleGlobal">Kaizen & A3/VAVE par Scope</h3>
                <button class="btn btn-secondary btn-sm" id="openScopeObjBtn">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                    Objectifs
                </button>
            </div>
            <canvas id="chartParScope"></canvas>
        </div>
        <div class="chart-card">
            <div class="objectives-header">
                <h3 id="statutChartTitleGlobal">Kaizen & A3/VAVE par Statut</h3>
                <button class="btn btn-secondary btn-sm" id="openStatutObjBtn">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                    Objectifs
                </button>
            </div>
            <canvas id="chartParStatut"></canvas>
        </div>
    </div>

    <div class="chart-card chart-card-wide">
        <div class="objectives-header">
            <h3>Objectif de Participation par Département</h3>
            <div class="objectives-filters">
                <button class="btn btn-primary btn-sm" id="openObjectivesBtn">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                    Objectif
                </button>
            </div>
        </div>
        <div class="chart-canvas-tall">
            <canvas id="chartObjectifs"></canvas>
        </div>
    </div>

    <div class="chart-grid-2">
        <div class="chart-card">
            <h3>Économies par Mois (€)</h3>
            <canvas id="chartEconomiesMois"></canvas>
        </div>
        <div class="chart-card">
            <h3>Économies par Département (€)</h3>
            <canvas id="chartEconomiesDepartement"></canvas>
        </div>
    </div>
</div>

<div class="modal-overlay" id="objectivesModal">
    <div class="modal-box modal-box-wide">
        <div class="modal-header">
            <h2>Objectifs par Département</h2>
            <button class="modal-close" id="closeObjectivesBtn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="modal-body full-width">
            <div class="form-group form-group-narrow">
                <label>Année concernée</label>
                <select id="objModalYear" class="select-input"></select>
            </div>
            <div class="table-scroll">
                <table class="objectives-table" id="objectivesTable">
                    <thead>
                        <tr>
                            <th>Département</th><th>Effectif</th><th>Objectif Annuel (%)</th>
                            <th>Jan</th><th>Feb</th><th>Mar</th><th>Apr</th><th>May</th><th>Jun</th>
                            <th>Jul</th><th>Aug</th><th>Sep</th><th>Oct</th><th>Nov</th><th>Dec</th>
                        </tr>
                    </thead>
                    <tbody id="objectivesTableBody"></tbody>
                </table>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="cancelObjectivesBtn">Annuler</button>
            <button type="button" class="btn btn-primary" id="saveObjectivesBtn">Enregistrer</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="scopeObjModal">
    <div class="modal-box modal-box-wide">
        <div class="modal-header">
            <h2>Objectif Scope par Département</h2>
            <button class="modal-close" id="closeScopeObjBtn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="modal-body full-width">
            <p class="section-subtitle" id="scopeObjPeriodLabel" style="margin-bottom:14px;"></p>
            <div class="table-scroll">
                <table class="objectives-table" id="scopeObjTable">
                    <thead id="scopeObjThead"></thead>
                    <tbody id="scopeObjBody"></tbody>
                </table>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="cancelScopeObjBtn">Annuler</button>
            <button type="button" class="btn btn-primary" id="saveScopeObjBtn">Enregistrer</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="statutObjModal">
    <div class="modal-box">
        <div class="modal-header">
            <h2>Objectif par Statut (%)</h2>
            <button class="modal-close" id="closeStatutObjBtn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="modal-body full-width">
            <table class="objectives-table" id="statutObjTable">
    <thead><tr><th>Statut</th><th>Nombre visé</th><th>%</th></tr></thead>
    <tbody></tbody>
</table>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="cancelStatutObjBtn">Annuler</button>
            <button type="button" class="btn btn-primary" id="saveStatutObjBtn">Enregistrer</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="headcountModal">
    <div class="modal-box">
        <div class="modal-header">
            <h2>Effectif par Département</h2>
            <button class="modal-close" id="closeHeadcountBtn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="modal-body full-width">
            <table class="objectives-table" id="headcountTable">
                <thead><tr><th>Département</th><th>Effectif</th></tr></thead>
                <tbody></tbody>
            </table>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="cancelHeadcountBtn">Annuler</button>
            <button type="button" class="btn btn-primary" id="saveHeadcountBtn">Enregistrer</button>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/stats-globale.css">
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-datalabels/2.2.0/chartjs-plugin-datalabels.min.js"></script>
    <script src="~/js/stats-globale.js"></script>
}