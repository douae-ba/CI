@{
    string active = ViewData["ActivePage"] as string ?? "";
    string LinkClass(string key) => active == key ? "sidebar-link active" : "sidebar-link";
}

<aside class="sidebar" id="appSidebar">
    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Réduire le menu">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>

    <div class="sidebar-logo">
        <img src="~/assets/logo.png" alt="Orhan Automotive">
    </div>

    <div class="sidebar-title">
        <span class="sidebar-title-main">ORHAN AUTOMOTIVE</span>
        <span class="sidebar-title-sub">CI Management</span>
    </div>

    <nav class="sidebar-nav">
        <a href="@Url.Action("Index", "Home")" class="@LinkClass("export")">
            <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <span class="label">Export / CI Plan</span>
        </a>
        <a href="@Url.Action("Index", "Initiatives")" class="@LinkClass("initiatives")">
            <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7c.6.4 1 1.2 1 2.05V17h6v-2.25c0-.85.4-1.64 1-2.05A7 7 0 0 0 12 2z"/></svg>
            <span class="label">Initiatives</span>
        </a>
        <a href="@Url.Action("Index", "InitiativesFinales")" class="@LinkClass("initiatives-finales")">
            <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span class="label">Initiatives Finales</span>
        </a>
        <a href="@Url.Action("Index", "StatistiquesSuggestions")" class="@LinkClass("stats-suggestions")">
            <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            <span class="label">Statistiques des Suggestions</span>
        </a>
        <a href="@Url.Action("Index", "StatistiquesGlobale")" class="@LinkClass("stats-globale")">
            <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            <span class="label">Statistiques Globale</span>
        </a>
    </nav>

    <div class="sidebar-bottom">
        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="logout-btn">
                <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span class="label">Déconnexion</span>
            </button>
        </form>
    </div>
</aside>